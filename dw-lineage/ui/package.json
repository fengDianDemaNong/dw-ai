{
  "name": "sql-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "//": "这个下限是 pnpm 时期定的（pnpm 11.x 依赖 node:sqlite，Node 22.13 起才有），迁到 npm 后已非必需；保留不动是有意的 —— node 版本是独立变量，与包管理器迁移混在一起会让「构建挂了」难以归因。要放宽请单独开一次。Dockerfile 的 node:22-alpine 同理。",
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run gen:menu && vite",
    "dev:standalone": "npm run gen:menu && VITE_RUN_MODE=standalone vite --port 5173",
    "dev:standard": "npm run gen:menu && VITE_RUN_MODE=standard vite --port 5173",
    "dev:multi": "npm run gen:menu && VITE_RUN_MODE=multi VITE_DEV_PORT=5173 VITE_DEV_PROXY_TARGET=http://127.0.0.1:18082 vite --port 5173",
    "build": "vue-tsc --noEmit && vite build",
    "build:no-check": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.vue",
    "check-format": "prettier --check .",
    "format:prettier": "prettier --write .",
    "gen:menu": "node scripts/gen-menu.mjs",
    "prebuild": "npm run gen:menu"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@antv/g6": "^4.8.17",
    "@antv/layout": "^0.3.0",
    "@dw-ai/engine": "*",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.4.0",
    "monaco-editor": "^0.41.0",
    "screenfull": "^5.2.0",
    "sql-formatter": "^12.2.3",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^5.61.0",
    "@typescript-eslint/parser": "^5.61.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.44.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-tailwindcss": "^3.13.0",
    "postcss": "^8.4.24",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0",
    "less": "^4.2.2"
  }
}
