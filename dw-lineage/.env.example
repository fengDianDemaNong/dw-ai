# ================================================================
#  docker compose 启动前的配置
#
#  用法：
#      cp .env.example .env      # 首次
#      vi .env                   # 按需修改
#      docker compose up -d
#
#  docker compose 会自动读取同目录下的 .env，不需要额外参数。
#  改完执行 docker compose up -d 重建容器生效。
#
#  ⚠️ .env 里会有数据库密码和加密密钥，不要提交到代码库。
# ================================================================


# ================================================================
#  一、后端存储数据库
#
#  血缘版本、元数据服务配置等都存在这里。
# ================================================================

# 可选值：h2 | mysql | postgresql
#   h2          内嵌数据库，数据存在 docker 卷 backend-data 中，免安装，适合单机与试用
#   mysql       需要 MySQL 8.0 及以上（血缘图遍历依赖递归 CTE，5.7 不支持）
#   postgresql  需要 PostgreSQL 12 及以上
DB_TYPE=h2

# ---------------- 以下仅在 type=mysql / postgresql 时需要填 ----------------
#
# ⚠️ 这里填的是「容器里看到的地址」，不是你在宿主机浏览器里用的地址：
#      数据库跑在宿主机上     ->  host.docker.internal
#      数据库是另一个容器     ->  它的服务名/容器名（需与本服务在同一网络）
#      数据库在别的机器上     ->  直接写 IP 或域名
#    不要写 localhost —— 容器里的 localhost 指向容器自己。
DB_HOST=host.docker.internal

# 留空则用默认端口：mysql 3306 / postgresql 5432
DB_PORT=

# ⚠️ 这个库要事先建好。程序只负责建表（Flyway 迁移），不会自动建库：
#      MySQL:      CREATE DATABASE dw_lineage DEFAULT CHARACTER SET utf8mb4;
#      PostgreSQL: CREATE DATABASE dw_lineage;
DB_NAME=dw_lineage

# 数据库用户名。DB_USER 与 dw-org / dw-model 同口径 —— 一套部署若共用一份 .env，填这个。
DB_USER=
# 上面那个的旧名字，仍认（DB_USER 为空时回落到它）。新配置不用填。
DB_USERNAME=
DB_PASSWORD=

# 附加连接参数，形如 useSSL=false&serverTimezone=Asia/Shanghai
DB_PARAMS=

# 需要特殊连接串时可直接给完整 JDBC URL。
# 填了它会忽略上面的 HOST / PORT / NAME，一般不用。
DB_URL=


# ================================================================
#  二、元数据服务
#
#  字段级血缘需要表结构。除了用 SQL 里的 CREATE TABLE，
#  还可以在控制台的「元数据服务」页面接入 Gravitino / dbx。
# ================================================================

# 页面上还没配任何服务时的兜底 Gravitino 地址。同样要用容器视角的地址。
GRAVITINO_URL=http://host.docker.internal:8090

# 「元数据服务」页面上 dbx 的登录密码等凭据，用这个密钥加密后存库。
#
# 留空服务照常启动，但保存带凭据的服务会明确报错 ——
# 这是刻意的：宁可保存失败，也不把凭据明文写进数据库。
#
# ⚠️ 换密钥会导致已存的凭据无法解密，需要在页面上重新录入，定下来就别改。
METADATA_SECRET_KEY=
