<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.13</version>
    <relativePath/>
  </parent>
  <groupId>com.dwai</groupId>
  <artifactId>dw-common</artifactId>
  <version>0.1.3</version>
  <name>dw-common</name>
  <description>
    组织与平台领域的共享类型：实体、Mapper、工具与跨服务 DTO。

    它不是「业务公共库」——只有**两侧逐字节相同**的类才允许进来。
    判断标准很硬：dw-org 与 dw-model 的同一文件必须完全一致才有资格搬进来；
    只要有一行差异，说明那是服务角色差异，应当留在各自服务里。

    依赖刻意保持最少：MyBatis-Plus core（实体注解 / BaseMapper / TypeHandler）、
    Spring Web（HttpStatus / ResponseStatusException）、Spring JDBC（SeedMain 的 ScriptUtils）、
    Jackson（Jsons）、PostgreSQL 驱动（PGobject，provided —— 运行时由使用方提供）。
    这里**不**引入任何 spring-boot-starter-* 起步依赖：起步依赖会带自动配置，
    共享库不该改变使用方的自动配置条件。因此 MyBatis 用的是 core 而不是 starter
    （使用方自己已经引入了 starter）。

    另外带一份 src/main/resources/db/seed/：dw-org 与 dw-model 的演示数据里
    **逐字节相同的身份层**（租户 / 账号 / 项目 / 授权码）。判断标准同上一段 ——
    只要有一行差异就是服务角色差异，留在各自服务里（如 project_members 的产品维度）。
  </description>

  <properties>
    <java.version>21</java.version>
    <mybatis-plus.version>3.5.9</mybatis-plus.version>
  </properties>

  <dependencies>
    <!-- 实体注解（@TableName 等）、BaseMapper；mybatis 的 BaseTypeHandler 由其传递引入。
         用 core 而不是 starter：共享库不引入自动配置。 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-core</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <!-- Perms 抛 ResponseStatusException、Jsons 用 Jackson -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <!-- SeedMain 用 ScriptUtils 执行 db/seed/*.sql。与 spring-web 同为核心栈（非 starter），
         不会带来自动配置。版本由 spring-boot-starter-parent 管理。 -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- JsonbStringTypeHandler 的 PGobject。编译需要，运行时由使用方提供驱动 -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
