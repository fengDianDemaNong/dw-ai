# 复制为 .env.local 后由 Vite 读取。不配 VITE_API_BASE_URL 时控制台仍走 localStorage 演示。

# Java API（阶段 4 真路径）。`.` = 与页面同源（Docker / 安装包）
VITE_API_BASE_URL=http://127.0.0.1:18080

# multi = 平台 + 多租户；standard = 单组织，无平台后台
# VITE_DEPLOY_MODE=multi

# 可选：规则服务，未配则走 API 同机
# VITE_RULES_BASE=http://127.0.0.1:7080

# Casdoor 授权码 + PKCE（不配则登录页走开发 JWT）
# 本机 Docker 示例（需自己在 Casdoor 控制台建 Application，并登记回调）：
#   docker run -d --name casdoor -p 8000:8000 casbin/casdoor:latest
# VITE_CASDOOR_ENDPOINT=http://127.0.0.1:8000
# VITE_CASDOOR_CLIENT_ID=
# VITE_CASDOOR_ORG=built-in
# VITE_CASDOOR_APP=app-built-in
# VITE_CASDOOR_REDIRECT_URI=http://localhost:5171/auth/callback

# 官方公开 demo（door.casdoor.com）未在本仓库验证。
# 若要用：在 Casdoor 应用里把 Redirect URL 加上本机回调，再填 clientId。
# 不要假设未验证的 demo 已经能登录。
# VITE_CASDOOR_ENDPOINT=https://door.casdoor.com
# VITE_CASDOOR_CLIENT_ID=
# VITE_CASDOOR_ORG=casbin
