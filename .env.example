# 复制为 .env 后供 docker compose 读取。不要提交 .env。

# ---------- 端口 ----------
ORG_UI_PORT=8080
MODEL_UI_PORT=8081
ORG_API_PORT=18080
API_PORT=18081

# ---------- 元数据库（默认不填 = 各容器自己的 H2，互不共用） ----------
# 租户管理 → dw_org
# ORG_DB_URL=jdbc:postgresql://postgres:5432/dw_org
# ORG_DB_USER=dwai
# ORG_DB_PASSWORD=dwai
# 建模 → dw_mode
# MODEL_DB_URL=jdbc:postgresql://postgres:5432/dw_mode
# MODEL_DB_USER=dwai
# MODEL_DB_PASSWORD=dwai

# PostgreSQL：docker compose --profile postgres up -d
POSTGRES_PORT=5432
POSTGRES_USER=dwai
POSTGRES_PASSWORD=dwai

# MySQL：docker compose --profile mysql up -d
MYSQL_PORT=3306
MYSQL_USER=dwai
MYSQL_PASSWORD=dwai
MYSQL_ROOT_PASSWORD=dwai
# ORG_DB_URL=jdbc:mysql://mysql:3306/dw_org?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=utf8
# MODEL_DB_URL=jdbc:mysql://mysql:3306/dw_mode?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=utf8

# ---------- 外部 StarRocks（可选） ----------
SR_ENABLED=false
SR_URL=jdbc:mysql://host.docker.internal:9030/dwai
SR_USER=root
SR_PASSWORD=

# ---------- 外部 DolphinScheduler（可选） ----------
DS_ENABLED=false
DS_URL=http://host.docker.internal:12345/dolphinscheduler
DS_TOKEN=
DS_PROJECT_CODE=0

# ---------- 鉴权（两套 API 的 JWT_SECRET 必须相同） ----------
SECURITY_MODE=dev
JWT_SECRET=dw-ai-dev-secret-change-me-please-32b
ALLOW_DEV_LOGIN=true
CORS_ORIGINS=*

# ---------- 服务间令牌（仅 multi 需要） ----------
# 组织平台创建租户/项目时把数据 fan-out 给仓建设/血缘，模块启动后也靠心跳让组织全量补发；
# 这条链路唯一的门禁就是这枚令牌。compose 里三个服务共用本文件的这一项，天然一致。
#
# 留空 = /internal/v1/** 一律 401（见 docs/tech/adr/0012-module-token-gate.md），
# 而且表现是静默的：组织里项目建得好好的，仓建设打开却是「还没有可进入的项目」，
# 数据地图报「租户编码未同步」，只有日志里有一行 401。
#
# 建议生成方式：openssl rand -hex 32
MODULE_TOKEN=

VITE_API_BASE=.
# DW_AI_MODE=standard
