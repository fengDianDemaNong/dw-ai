# 复制为 .env 后供 docker compose 读取。不要提交 .env。

# ---------- 端口 ----------
UI_PORT=80
API_PORT=8080

# ---------- 元数据库（默认不填 = 容器内 H2） ----------
# DB_URL=
# DB_USER=
# DB_PASSWORD=
# DB_TYPE=

# PostgreSQL：docker compose --profile postgres up -d
POSTGRES_PORT=5432
POSTGRES_DB=dwai
POSTGRES_USER=dwai
POSTGRES_PASSWORD=dwai
# DB_URL=jdbc:postgresql://postgres:5432/dwai
# DB_USER=dwai
# DB_PASSWORD=dwai

# MySQL：docker compose --profile mysql up -d
MYSQL_PORT=3306
MYSQL_DATABASE=dwai
MYSQL_USER=dwai
MYSQL_PASSWORD=dwai
MYSQL_ROOT_PASSWORD=dwai
# DB_URL=jdbc:mysql://mysql:3306/dwai?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=utf8
# DB_USER=dwai
# DB_PASSWORD=dwai

# ---------- 外部 StarRocks（可选） ----------
SR_ENABLED=false
SR_URL=jdbc:mysql://host.docker.internal:9030/dwai
SR_USER=root
SR_PASSWORD=

# ---------- 外部 DolphinScheduler（可选） ----------
DS_ENABLED=false
DS_URL=http://host.docker.internal:12345/dolphinscheduler
DS_TOKEN=
DS_PROJECT_CODE=0

# ---------- 鉴权 ----------
SECURITY_MODE=dev
JWT_SECRET=dw-ai-dev-secret-change-me-please-32b
ALLOW_DEV_LOGIN=true
CORS_ORIGINS=*

VITE_API_BASE=.
# DW_AI_MODE=multi
